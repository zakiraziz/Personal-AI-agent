import "server-only";
import { Configuration, OpenAIApi } from "openai";

// ElevenLabs API configuration
const ElevenLabs_API_KEY = process.env.ELEVENLABS_API_KEY;

if (!ElevenLabs_API_KEY) {
  throw new Error("ELEVENLABS_API_KEY is not defined in .env.local");
}

const configuration = new Configuration({
  apiKey: ElevenLabs_API_KEY,
});
const openai = new OpenAIApi(configuration);

export const config = {
  api: {
    bodyParser: false,
  },
};

export async function POST(request: NextRequest) {
  try {
    const { text } = await request.json();

    if (!text) {
      return new Response(JSON.stringify({ error: "Text is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
      });
    }

    // Call ElevenLabs Text-to-Speech API
    const response = await openai.createAudio({
      voice: "pNInz6obpgDQGcFmaJgB", // "Adam" voice
      output_format: "mp3",
      text: text,
    });

    const audioBuffer = response.data;

    // Convert buffer to base64 data URL
    const audioBase64 = audioBuffer.toString("base64");
    const audioUrl = `data:audio/mp3;base64,${audioBase64}`;

    return new Response(JSON.stringify({ audioUrl }), {
      status: 200,
      headers: { "Content-Type": "application/json" },
    });
  } catch (error: any) {
    console.error("ElevenLabs TTS error:", error);
    return new Response(JSON.stringify({ error: "Failed to generate voiceover" }), {
      status: 500,
      headers: { "Content-Type": "application/json" },
    });
  }
}